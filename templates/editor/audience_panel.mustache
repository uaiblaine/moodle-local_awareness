{{!
    @template local_awareness/editor/audience_panel

    Asynchronous audience-estimate widget. Renders the notice's stored count, or an idle state
    when there is none, on first load; audience_estimator.js takes over from there, moving
    between the queued, cached, timeout and error states.

    Context variables required:
    * audience.autotrigger (bool) — true when the site is small enough to estimate as you edit
    * audience.auto (int) — the same decision as 1 or 0, read by the JS from data-auto
    * audience.summary (array of {key, label, value}) — key feeds data-summary-key, which the JS
      writes the recomputed count into; label is the already-resolved string
    * audience.hascount (bool) — whether a stored count exists to render
    * audience.initialcountformatted (string) — that count, formatted
    * audience.initialstate_idle (bool) — no stored count: the state line says reach has not been
      calculated yet
    * audience.initialstate_cached (bool) — a stored count: the state line shows cachedlabel
    * audience.cachedlabel (string) — when the stored count was computed, and whether it still
      matches the notice's filters; empty when there is no stored count
    * audience.contextrules (array of {key, label})
    * audience.threshold (int) — used by JS via data attribute
    * audience.poll_interval_ms (int)
    * audience.poll_max (int)

    Example context (json):
    {
        "audience": {
            "autotrigger": true,
            "auto": 1,
            "summary": [{"key": "cohorts", "label": "Cohorts", "value": 0}],
            "hascount": false,
            "initialcountformatted": "—",
            "initialstate_idle": true,
            "initialstate_cached": false,
            "cachedlabel": "",
            "contextrules": [],
            "threshold": 3,
            "poll_interval_ms": 10000,
            "poll_max": 30
        }
    }
}}
<section class="local-awareness-audience"
         data-region="local-awareness-audience"
         data-threshold="{{audience.threshold}}"
         data-auto="{{audience.auto}}"
         data-poll-interval-ms="{{audience.poll_interval_ms}}"
         data-poll-max="{{audience.poll_max}}"
         aria-labelledby="local-awareness-audience-title">
    <header class="local-awareness-audience-head">
        <h3 id="local-awareness-audience-title" class="local-awareness-audience-title">
            <i class="fa fa-bullseye" aria-hidden="true"></i>
            {{#str}}audience:title, local_awareness{{/str}}
        </h3>
    </header>

    <dl class="local-awareness-audience-summary" data-slot="summary">
        {{#audience.summary}}
            <div class="local-awareness-audience-summary-item">
                <dt>{{label}}</dt>
                <dd data-summary-key="{{key}}">{{value}}</dd>
            </div>
        {{/audience.summary}}
    </dl>

    <div class="local-awareness-audience-reach" data-slot="reach"
         aria-live="polite" aria-atomic="true">
        <div class="local-awareness-audience-reach-meta">
            <span class="local-awareness-audience-reach-label">{{#str}}audience:reach:label, local_awareness{{/str}}</span>
            <span class="local-awareness-audience-reach-state" data-slot="state">
                {{#audience.initialstate_idle}}{{#str}}audience:state:idle, local_awareness{{/str}}{{/audience.initialstate_idle}}
                {{#audience.initialstate_cached}}{{audience.cachedlabel}}{{/audience.initialstate_cached}}
            </span>
        </div>
        <div class="local-awareness-audience-reach-value" data-slot="value">
            {{! hascount, not initialcount: a real audience of zero is a number worth showing, and
                a section on the value itself would render it as "not calculated". }}
            {{#audience.hascount}}{{audience.initialcountformatted}}{{/audience.hascount}}
            {{^audience.hascount}}—{{/audience.hascount}}
        </div>
    </div>

    <div class="local-awareness-audience-actions" data-slot="actions">
        <button type="button" class="local-awareness-btn local-awareness-btn--brand" data-action="calculate"
                {{#audience.autotrigger}}hidden{{/audience.autotrigger}}>
            <i class="fa fa-bolt" aria-hidden="true"></i>
            {{#str}}audience:btn:calculate, local_awareness{{/str}}
        </button>
        <button type="button" class="local-awareness-btn local-awareness-btn--ghost" data-action="retry" hidden>
            <i class="fa fa-refresh" aria-hidden="true"></i>
            {{#str}}audience:btn:retry, local_awareness{{/str}}
        </button>
    </div>

    <div class="local-awareness-audience-breakdown" data-slot="breakdown" hidden></div>

    <div class="local-awareness-audience-context" data-slot="context"
         {{^audience.contextrules}}hidden{{/audience.contextrules}}>
        <h4 class="local-awareness-audience-context-title">
            <i class="fa fa-filter" aria-hidden="true"></i>
            {{#str}}audience:context_restrictions:title, local_awareness{{/str}}
        </h4>
        <p class="local-awareness-audience-context-hint">{{#str}}audience:context_restrictions:hint, local_awareness{{/str}}</p>
        <ul class="local-awareness-audience-chips" data-slot="contextchips">
            {{#audience.contextrules}}
                <li class="local-awareness-rulechip" data-key="{{key}}">{{label}}</li>
            {{/audience.contextrules}}
        </ul>
    </div>
</section>
